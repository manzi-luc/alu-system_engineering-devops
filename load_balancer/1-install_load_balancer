#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 (roundrobin)
apt-get update -y
apt-get install -y haproxy
if [ ! -f /etc/haproxy/haproxy.cfg.backup ]; then
  cp /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.backup
fi
if ! grep -q "web_servers" /etc/haproxy/haproxy.cfg; then
  cat >> /etc/haproxy/haproxy.cfg << 'EOF'

frontend http_front
    bind *:80
    mode http
    default_backend web_servers

backend web_servers
    mode http
    balance roundrobin
    server 7331-web-01 35.177.198.139:80 check
    server 7331-web-02 	3.10.22.172:80 check
EOF
fi
haproxy -c -f /etc/haproxy/haproxy.cfg && service haproxy restart

